<Window x:Class="PlaylistAudioSaver.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Playlist Audio Saver" Icon="Assets/AppIcon.ico" Width="1240" Height="860" MinWidth="980" MinHeight="690"
 FontFamily="Segoe UI Variable Text, Yu Gothic UI" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
 WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Grid Margin="12,22,12,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="12,0,0,28">
    <Image Source="{StaticResource AppIcon}" Width="36" Height="36" Margin="0,0,11,0" AutomationProperties.Name="Playlist Audio Saver" />
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Playlist" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Audio Saver" Style="{StaticResource Muted}" FontSize="11" /></StackPanel>
   </StackPanel>
   <StackPanel Grid.Row="1">
    <RadioButton x:Name="LibraryNav" Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="True" Checked="Library_Click" AutomationProperties.Name="ライブラリ">
     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" Margin="0,0,14,0" /><TextBlock Text="ライブラリ" /></StackPanel>
    </RadioButton>
    <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" GroupName="Navigation" Checked="Settings_Click" AutomationProperties.Name="設定">
     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,14,0" /><TextBlock Text="設定" /></StackPanel>
    </RadioButton>
   </StackPanel>
   <StackPanel Grid.Row="3">
    <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,12">
     <StackPanel><TextBlock Text="Spotify" FontWeight="SemiBold" />
      <TextBlock x:Name="ConnectionText" Text="起動中…" Style="{StaticResource Muted}" Margin="0,5,0,0" />
     </StackPanel>
    </Border>
    <Button Style="{StaticResource Action}" Click="Folder_Click" HorizontalContentAlignment="Left" ToolTip="保存先のフォルダーを開く">
     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Margin="0,0,12,0" /><TextBlock Text="保存先を開く" /></StackPanel>
    </Button>
    <TextBlock x:Name="VersionText" Text="Playlist Audio Saver" Style="{StaticResource Muted}" Margin="12,18,0,0" FontSize="11" />
   </StackPanel>
  </Grid>
  <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0" Margin="0,10,0,0">
   <Grid>
    <Grid x:Name="LibraryPage" Margin="30,25,30,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,22"><TextBlock Text="ライブラリ" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="お気に入りの音楽を、手元に。" Style="{StaticResource Muted}" Margin="0,7,0,0" FontSize="13" /></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
       <DockPanel Margin="0,0,0,12"><TextBlock Text="Spotifyリンク" FontWeight="SemiBold" /><TextBlock Text="プレイリスト / アルバム / シングル / 曲" Style="{StaticResource Muted}" HorizontalAlignment="Right" /></DockPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0">
         <TextBox x:Name="UrlInput" Style="{StaticResource Field}" Height="40" KeyDown="Url_KeyDown" AutomationProperties.Name="Spotifyリンク" ToolTip="Spotifyの共有リンクまたはspotify: URI" />
         <TextBlock Text="https://open.spotify.com/…" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=UrlInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
        <Button x:Name="LoadButton" Grid.Column="1" Content="読み込む" Style="{StaticResource Primary}" MinWidth="108" Click="Load_Click" IsEnabled="False" />
       </Grid>
       <TextBlock x:Name="SourceNote" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="Collapsed" />
      </StackPanel>
     </Border>
     <Grid Grid.Row="2" Margin="0,19,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"><TextBlock Text="1" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border><TextBlock Text="リンクを読み込む" VerticalAlignment="Center" FontSize="12" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,8,0"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border><TextBlock Text="対応を検索・確認" VerticalAlignment="Center" FontSize="12" /></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,8,0"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border><TextBlock Text="MP3で保存" VerticalAlignment="Center" FontSize="12" /></StackPanel>
     </Grid>
     <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="CollectionTitle" Text="音楽を追加" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock x:Name="CollectionInfo" Text="読み込んだ曲がここに表示されます" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></StackPanel>
        <Button x:Name="MatchButton" Grid.Column="1" Style="{StaticResource Action}" Click="Match_Click" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" /><TextBlock Text="対応を検索" /></StackPanel></Button>
       </Grid>
       <Grid Grid.Row="1">
        <DataGrid x:Name="TrackGrid" RowStyle="{DynamicResource TrackRowStyle}" CellStyle="{DynamicResource TrackCellStyle}" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowHeight="80" ColumnHeaderHeight="36" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="Track_SelectionChanged" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto">
         <DataGrid.Resources>
          <Style x:Key="TrackCellStyle" TargetType="DataGridCell">
           <Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
           <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
           <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent"><ContentPresenter VerticalAlignment="Stretch" /></Border></ControlTemplate></Setter.Value></Setter>
          </Style>
          <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8,0" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" /></Style>
          <Style x:Key="TrackRowStyle" TargetType="DataGridRow">
           <Setter Property="ToolTip" Value="{Binding Detail}" />
           <Setter Property="Background" Value="Transparent" />
           <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
           <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
            <Grid Background="{TemplateBinding Background}"><DataGridCellsPresenter x:Name="PART_CellsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" /><Border x:Name="SelectedMark" Width="3" Height="28" CornerRadius="2" HorizontalAlignment="Left" Background="Transparent" IsHitTestVisible="False" /></Grid>
            <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedMark" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" /></Trigger></ControlTemplate.Triggers>
           </ControlTemplate></Setter.Value></Setter>
           <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
            <DataTrigger Binding="{Binding Excluded}" Value="True"><Setter Property="Opacity" Value="0.5" /></DataTrigger>
           </Style.Triggers>
          </Style>
         </DataGrid.Resources>
         <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="42"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="14,0,0,0" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
          <DataGridTemplateColumn Header="SPOTIFY" Width="*" MinWidth="175"><DataGridTemplateColumn.CellTemplate><DataTemplate>
           <StackPanel VerticalAlignment="Center" Margin="8,0,12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,6,0,0" /></StackPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="YOUTUBE の候補" Width="1.4*" MinWidth="230"><DataGridTemplateColumn.CellTemplate><DataTemplate>
           <Grid Margin="6,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="72" Height="44" CornerRadius="5" Background="{DynamicResource SubtleFillColorSecondaryBrush}"><Grid><TextBlock Text="&#xE714;" Style="{StaticResource Glyph}" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" /></Grid></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding VideoTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding VideoTitle}" /><TextBlock Text="{Binding VideoSubtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,6,0,0" /></StackPanel>
           </Grid>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="状態" Width="108"><DataGridTemplateColumn.CellTemplate><DataTemplate>
           <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <TextBlock Text="{Binding Status}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="要確認"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="失敗"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="保存済み"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           </Border>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
         <Border Width="76" Height="76" CornerRadius="22" Background="{DynamicResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"><TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="32" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" /></Border>
         <TextBlock Text="好きな音楽から、はじめよう。" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
         <TextBlock Text="Spotifyの共有リンクを上に貼り付けてください。&#10;公開プレイリストやアルバム、1曲からでも。" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,0" LineHeight="22" />
        </StackPanel>
       </Grid>
       <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,9">
        <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
         <Button x:Name="SpotifyLinkButton" Content="Spotify ↗" Click="SpotifyLink_Click" IsEnabled="False" Padding="9,5" ToolTip="選択曲をSpotifyで開く" />
         <Button x:Name="YoutubeLinkButton" Content="YouTube ↗" Click="YoutubeLink_Click" IsEnabled="False" Padding="9,5" Margin="6,0,0,0" ToolTip="選択した候補をYouTubeで開く" />
         <Button x:Name="CorrectButton" Content="候補を訂正" Click="Correct_Click" IsEnabled="False" Padding="9,5" Margin="6,0,0,0" />
         <Button x:Name="ExcludeButton" Content="除外" Click="Exclude_Click" IsEnabled="False" Padding="10,5" Margin="6,0,0,0" />
        </StackPanel><TextBlock x:Name="SelectionHint" Text="曲を選ぶと候補の確認・除外ができます" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,10,0" /></DockPanel>
       </Border>
      </Grid>
     </Border>
     <Grid Grid.Row="4" Margin="0,18,0,20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <ProgressBar x:Name="Progress" Height="3" Maximum="100" Margin="0,0,0,15" />
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="StatusText" Text="準備しています…" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><TextBlock x:Name="OutputText" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="停止" Style="{StaticResource Action}" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,8,0" /><Button x:Name="SaveButton" Style="{StaticResource Primary}" Click="Save_Click" IsEnabled="False" Content="確認済みを保存" MinWidth="150" /></StackPanel>
      </Grid>
     </Grid>
    </Grid>
    <Grid x:Name="SettingsPage" Margin="30,25,30,0" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,22"><TextBlock Text="設定" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Spotifyとの接続と、音楽の保存方法。" Style="{StaticResource Muted}" Margin="0,7,0,0" FontSize="13" /></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
      <StackPanel x:Name="SettingsFields">
       <TextBlock Text="Spotify連携" FontWeight="SemiBold" Margin="0,0,0,10" />
       <Border Style="{StaticResource Card}" Margin="0,0,0,22"><StackPanel>
        <DockPanel><Button Content="Dashboardを開く ↗" DockPanel.Dock="Right" Click="Dashboard_Click" Style="{StaticResource Action}" /><TextBlock Text="非公開の音楽にもアクセス" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
        <TextBlock Text="公開リンクはそのまま読み込めます。非公開プレイリストや詳細な曲情報の取得には、ご自身のSpotifyアプリを接続してください。Client Secretは不要です。" Style="{StaticResource Muted}" Margin="0,10,0,18" />
        <TextBlock Text="1. DashboardでRedirect URIを登録" Margin="0,0,0,7" />
        <DockPanel><Button Content="コピー" Click="CopyRedirect_Click" DockPanel.Dock="Right" Margin="10,0,0,0" /><TextBox x:Name="RedirectInput" Style="{StaticResource Field}" IsReadOnly="True" AutomationProperties.Name="Redirect URI" /></DockPanel>
        <TextBlock Text="2. Client IDを貼り付け" Margin="0,17,0,7" />
        <TextBox x:Name="ClientIdInput" Style="{StaticResource Field}" AutomationProperties.Name="Spotify Client ID" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="ConnectButton" Content="Spotifyに接続" Click="Connect_Click" /><Button x:Name="DisconnectButton" Content="接続を解除" Click="Disconnect_Click" Margin="8,0,0,0" /></StackPanel>
       </StackPanel></Border>
       <TextBlock Text="保存" FontWeight="SemiBold" Margin="0,0,0,10" />
       <Border Style="{StaticResource Card}" Margin="0,0,0,22"><StackPanel>
        <TextBlock Text="保存先フォルダー" Margin="0,0,0,7" /><DockPanel><Button Content="参照" DockPanel.Dock="Right" Click="BrowseOutput_Click" Margin="10,0,0,0" /><TextBox x:Name="OutputInput" Style="{StaticResource Field}" AutomationProperties.Name="保存先フォルダー" /></DockPanel>
        <TextBlock Text="FFmpeg" Margin="0,17,0,7" /><DockPanel><Button Content="参照" DockPanel.Dock="Right" Click="BrowseFfmpeg_Click" Margin="10,0,0,0" /><TextBox x:Name="FfmpegInput" Style="{StaticResource Field}" AutomationProperties.Name="FFmpeg実行ファイル" /></DockPanel>
        <TextBlock x:Name="FfmpegStatus" Text="空欄の場合はPATHから自動検出します。" Style="{StaticResource Muted}" Margin="0,7,0,16" />
        <CheckBox x:Name="SkipCheck" Content="同名の保存済みファイルをスキップする" />
       </StackPanel></Border>
       <TextBlock Text="検索と音質" FontWeight="SemiBold" Margin="0,0,0,10" />
       <Border Style="{StaticResource Card}" Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0"><TextBlock Text="市場" Margin="0,0,0,8" /><TextBox x:Name="MarketInput" Style="{StaticResource Field}" MaxLength="2" AutomationProperties.Name="市場の国コード" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="音質（0 = 最高）" Margin="0,0,0,8" /><ComboBox x:Name="QualityInput" MinHeight="36" AutomationProperties.Name="MP3音質" /></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="検索候補数" Margin="0,0,0,8" /><ComboBox x:Name="ResultsInput" MinHeight="36" AutomationProperties.Name="検索候補数" /></StackPanel>
       </Grid></Border>
       <TextBlock Text="訂正履歴" FontWeight="SemiBold" Margin="0,0,0,10" />
       <Border Style="{StaticResource Card}" Margin="0,0,0,22"><StackPanel>
        <DockPanel><Button x:Name="ForgetCorrectionsButton" Content="履歴を消去" Click="ForgetCorrections_Click" DockPanel.Dock="Right" Style="{StaticResource Action}" AutomationProperties.Name="訂正履歴を消去" /><TextBlock x:Name="CorrectionsText" Text="訂正履歴" VerticalAlignment="Center" FontWeight="SemiBold" /></DockPanel>
        <TextBlock Text="「候補を訂正」で選んだ動画を記録し、次回の検索でその曲に自動で適用します。同じアーティストの他の曲でも、選んだチャンネルを優先します。" Style="{StaticResource Muted}" Margin="0,10,0,0" />
       </StackPanel></Border>
       <TextBlock Text="アプリについて" FontWeight="SemiBold" Margin="0,0,0,10" />
       <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
        <DockPanel><Button x:Name="UpdateButton" Content="更新を確認" Click="Update_Click" DockPanel.Dock="Right" Style="{StaticResource Action}" /><TextBlock x:Name="AboutVersion" Text="Playlist Audio Saver" VerticalAlignment="Center" FontWeight="SemiBold" /></DockPanel>
        <CheckBox x:Name="UpdatesCheck" Content="起動時に更新を確認する" Margin="0,16,0,0" />
       </StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
     <DockPanel Grid.Row="2" Margin="0,18,0,20"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="変更を戻す" Click="ResetSettings_Click" Style="{StaticResource Action}" Margin="0,0,8,0" /><Button x:Name="SettingsSaveButton" Content="設定を保存" Click="SaveSettings_Click" Style="{StaticResource Primary}" /></StackPanel><TextBlock x:Name="SettingsStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" /></DockPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
